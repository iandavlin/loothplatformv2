[Unit]
Description=BB-mirror outbox worker (redelivers WP->mirror events the fast path dropped)
After=network.target postgresql.service php8.3-fpm.service mysql.service

[Service]
Type=oneshot
User=looth-dev
WorkingDirectory=/var/www/dev
ExecStart=/usr/local/bin/wp eval-file /srv/bb-mirror/bin/outbox-worker.php
StandardOutput=journal
StandardError=journal
# Exit 1 means delivery is stuck and the mirror is diverging from WordPress.
# systemd marking the unit failed IS the alert channel: `systemctl status
# bb-mirror-outbox` and `systemctl --failed` both surface it. Deliberately not
# wp_mail — on dev2 that is a false positive (mailpit swallows it).
